# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA MUNICIPAL SGR LA SERENA
# ==============================================================================
# En AWS App Runner, no se sube el archivo .env físico.
# En su lugar, estas variables se configuran directamente en la consola de
# AWS App Runner > Service Settings > Environment variables.

# ------------------------------------------------------------------------------
# 1. SEGURIDAD BÁSICA DE DJANGO
# ------------------------------------------------------------------------------
# Genera una clave secreta segura de 50+ caracteres para producción
SECRET_KEY=django-insecure-cambiar-por-una-clave-super-secreta-en-aws-apprunner-1234567890

# En AWS App Runner DEBE ser False
DEBUG=False

# Dominios permitidos separados por coma (ej: *.awsapprunner.com,tudominio.cl)
ALLOWED_HOSTS=*.awsapprunner.com,localhost,127.0.0.1

# Orígenes confiables para protección CSRF en HTTPS (OBLIGATORIO para formularios y login)
CSRF_TRUSTED_ORIGINS=https://*.awsapprunner.com

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (AWS RDS PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Formato: postgres://USUARIO:PASSWORD@HOST_RDS:5432/NOMBRE_DB
# Si se deja vacío, usará SQLite local de respaldo (no recomendado en contenedores efímeros)
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. PRECARGA INICIAL DE DATOS MUNICIPALES (Opcional en el primer despliegue)
# ------------------------------------------------------------------------------
# Pon en True en el primer despliegue para crear roles y usuario admin automáticamente
POBLAR_SISTEMA=False

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DE CORREO SMTP (Recuperación de contraseña vía código)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion_16_caracteres
DEFAULT_FROM_EMAIL=Plataforma SGR La Serena <tu_correo@gmail.com>

# 5. PASSKEYS AND HTTPS (use the actual AWS HTTPS hostname)
WEBAUTHN_RP_ID=replace-with-your-aws-hostname
WEBAUTHN_ORIGIN=https://replace-with-your-aws-hostname
SECURE_COOKIE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0

# Enable only with Gunicorn bound to loopback and Nginx overwriting X-Real-IP.
WEBAUTHN_TRUST_LOOPBACK_PROXY=True
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
